{
  "name": "todoist-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Todoist",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "TRANSPORT=stdio node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "format": "biome format --write src",
    "fix": "biome check --write src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.1",
    "axios": "1.13.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
